//@version=6
// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// EMA20 Close Fade — with risk normalisation and trend-quality filters
//
// THE SIGNAL, STATED PLAINLY
//
// A sell fires when a candle CLOSES ABOVE the slow EMA while the fast EMA is
// still BELOW it. Read the two halves separately:
//
//   emaF < emaS          "the trend is down"
//   close > emaS         "price has poked back up through the mean"
//
// So the trade is: fade a pullback into the mean, in the direction of the
// prevailing trend. That is a sound, well-worn idea. The edge, if it exists,
// comes from the pullback failing and the trend resuming.
//
// WHERE IT LOSES, AND WHY
//
// The signal cannot tell the difference between the two things that produce an
// identical candle:
//
//   1. A pullback into resistance inside a live downtrend  -> the trade works.
//   2. The FIRST candle of a genuine reversal              -> the trade loses,
//      and loses badly, because the stop sits just above that candle and price
//      keeps going.
//
// Every filter below exists to separate (1) from (2). None of them invent a new
// signal; they ask whether the context that makes the fade sensible is actually
// present. Each is measured in ATR units so the numbers mean the same thing on
// any symbol and any timeframe.
//
//   trend slope   Is the slow EMA actually falling, or is it flat? A flat slow
//                 EMA means chop, and in chop every poke through the mean looks
//                 like a signal while none of them are.
//   separation    Is the fast EMA meaningfully below the slow one, or are they
//                 converging? Converging EMAs are a trend ending. Fading the
//                 pullback of a trend that is already over is case (2).
//   extension     How far above the mean did the candle close? A small poke is
//                 a pullback. A large one is a breakout, and fading breakouts is
//                 how an account dies.
//
// THE SIZING CHANGE MATTERS MORE THAN THE FILTERS
//
// The original sized every trade at 100% of equity. Because the stop is placed
// beyond the signal candle, the distance to that stop varies with candle size -
// so a wide-candle signal and a narrow-candle signal took the SAME position and
// risked wildly different amounts. Gross loss was therefore dominated by
// whichever losers happened to have big candles, which is noise, not edge.
//
// Risk-based sizing makes every trade risk the same fraction of equity. It does
// not improve the signal at all. It makes the loss distribution flat instead of
// fat-tailed, which is most of what "reduce the gross loss" actually means.

strategy("EMA20 Close Fade | filtered", overlay=true, shorttitle="EMA_FADE",
     initial_capital         = 10000,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     process_orders_on_close = true,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.0)

// ───────────────────────── Signal ─────────────────────────
grpS = "Signal"
fastLen = input.int(10, "Fast EMA", minval=1, group=grpS)
slowLen = input.int(20, "Slow EMA", minval=1, group=grpS)
srcEma  = input.source(close, "EMA source", group=grpS)

mode = input.string("Both", "Trading mode", options=["Both", "Sell only", "Buy only", "Off"], group=grpS,
     tooltip="Off = no new entries (flat / manage only).")

// ───────────────────────── Sizing ─────────────────────────
grpZ = "Sizing"
useRiskSizing = input.bool(true, "Size by risk instead of equity %", group=grpZ,
     tooltip="ON: every trade risks riskPct of equity, whatever the stop distance. " +
             "OFF: the original behaviour, a fixed % of equity per trade regardless of risk.")
riskPct    = input.float(1.0, "Risk per trade (% equity)", minval=0.01, maxval=10, step=0.1, group=grpZ)
equityPct  = input.float(100, "Equity % per trade (when risk sizing is off)", minval=1, maxval=100, step=5, group=grpZ)

// ───────────────────────── Risk ─────────────────────────
grpR = "Risk"
bufPts   = input.float(50, "SL buffer (points)", minval=0, step=1, group=grpR,
     tooltip="Points beyond the signal candle high (sell) / low (buy).")
pointMul = input.float(1.0, "Point = mintick x", minval=0.0001, step=0.1, group=grpR,
     tooltip="Set 10 on 5-digit FX if you mean 'pips-style' points.")
rr1 = input.float(1.0, "TP1 R:R", minval=0.1, step=0.1, group=grpR)
rr2 = input.float(2.0, "TP2 R:R", minval=0.1, step=0.1, group=grpR)
rr3 = input.float(3.0, "TP3 R:R", minval=0.1, step=0.1, group=grpR)
q1  = input.int(34, "TP1 % of ORIGINAL position", minval=1, maxval=100, group=grpR)
q2  = input.int(33, "TP2 % of ORIGINAL position", minval=1, maxval=100, group=grpR)
beAfterTP1 = input.bool(true, "Move SL to break-even after TP1", group=grpR)

// ───────────────────────── Filters ─────────────────────────
grpF = "Trend quality filters (0 = off)"
atrLen      = input.int(14,   "ATR length", minval=1, group=grpF)
slopeLen    = input.int(10,   "Slow-EMA slope lookback (bars)", minval=1, group=grpF)
minSlopeAtr = input.float(0.10, "Min slow-EMA slope (ATR over lookback)", minval=0, step=0.05, group=grpF,
     tooltip="Rejects a flat slow EMA. A flat mean is chop, and in chop every poke through it looks like a signal.")
minSepAtr   = input.float(0.15, "Min EMA separation (ATR)", minval=0, step=0.05, group=grpF,
     tooltip="Rejects converging EMAs. Converging means the trend is ending, so the pullback may be a reversal.")
maxExtAtr   = input.float(1.00, "Max close extension beyond slow EMA (ATR), 0 = off", minval=0, step=0.1, group=grpF,
     tooltip="Rejects a candle that closed far beyond the mean. That is a breakout, not a poke.")
minStopAtr  = input.float(0.20, "Min stop distance (ATR), 0 = off", minval=0, step=0.05, group=grpF,
     tooltip="A stop tighter than this is noise; with risk sizing it also implies a very large position.")
maxStopAtr  = input.float(2.50, "Max stop distance (ATR), 0 = off", minval=0, step=0.1, group=grpF,
     tooltip="A stop this wide means the signal candle was huge; the trade needs an implausible move to reach TP3.")

oneSignalPerCross = input.bool(true, "Only first signal per condition run", group=grpF,
     tooltip="Fires on the first bar the condition becomes true, not on every bar it stays true.")
useSession = input.bool(false, "Restrict to session", group=grpF)
sess       = input.session("0000-2359", "Session", group=grpF)
showTable  = input.bool(true, "Show signal funnel", group=grpF)

// ───────────────────────── Calc ─────────────────────────
emaF = ta.ema(srcEma, fastLen)
emaS = ta.ema(srcEma, slowLen)
atr  = ta.atr(atrLen)
pt   = syminfo.mintick * pointMul
buf  = bufPts * pt

inSess = not useSession or not na(time(timeframe.period, sess))

// Raw conditions, unchanged from the original.
rawSell = close > emaS and emaF < emaS
rawBuy  = close < emaS and emaF > emaS

firstSell = not oneSignalPerCross or not rawSell[1]
firstBuy  = not oneSignalPerCross or not rawBuy[1]

allowSell = (mode == "Both" or mode == "Sell only")
allowBuy  = (mode == "Both" or mode == "Buy only")

// Context, all in ATR units so one number means the same thing everywhere.
atrOk     = not na(atr) and atr > 0
slopeAtr  = atrOk ? (emaS - emaS[slopeLen]) / atr : 0.0   // negative = falling
sepAtr    = atrOk ? (emaF - emaS) / atr            : 0.0   // negative = fast below slow
extSell   = atrOk ? (close - emaS) / atr           : 0.0   // how far above the mean we closed
extBuy    = atrOk ? (emaS - close) / atr           : 0.0

// Prospective stop distance, needed before sizing and before the filters.
stopSell  = (high + buf) - close
stopBuy   = close - (low - buf)
stopAtrS  = atrOk ? stopSell / atr : 0.0
stopAtrB  = atrOk ? stopBuy  / atr : 0.0

trendOkSell = slopeAtr <= -minSlopeAtr and sepAtr <= -minSepAtr
trendOkBuy  = slopeAtr >=  minSlopeAtr and sepAtr >=  minSepAtr

extOkSell = maxExtAtr <= 0 or extSell <= maxExtAtr
extOkBuy  = maxExtAtr <= 0 or extBuy  <= maxExtAtr

stopOkSell = stopSell > 0 and (minStopAtr <= 0 or stopAtrS >= minStopAtr) and (maxStopAtr <= 0 or stopAtrS <= maxStopAtr)
stopOkBuy  = stopBuy  > 0 and (minStopAtr <= 0 or stopAtrB >= minStopAtr) and (maxStopAtr <= 0 or stopAtrB <= maxStopAtr)

baseSell = rawSell and firstSell and allowSell and strategy.position_size == 0
baseBuy  = rawBuy  and firstBuy  and allowBuy  and strategy.position_size == 0

sellSignal = baseSell and inSess and atrOk and trendOkSell and extOkSell and stopOkSell
buySignal  = baseBuy  and inSess and atrOk and trendOkBuy  and extOkBuy  and stopOkBuy

// ───────────────────────── Funnel ─────────────────────────
// Every filter is counted, so the cost of each one is a number rather than an
// opinion. If a filter rejects almost everything, it is too tight; if it rejects
// almost nothing, it is not earning its place.
var int nRaw     = 0
var int nSess    = 0
var int nTrend   = 0
var int nExt     = 0
var int nStop    = 0
var int nTaken   = 0

if baseSell or baseBuy
    nRaw += 1
    if not inSess or not atrOk
        nSess += 1
    else if not (baseSell ? trendOkSell : trendOkBuy)
        nTrend += 1
    else if not (baseSell ? extOkSell : extOkBuy)
        nExt += 1
    else if not (baseSell ? stopOkSell : stopOkBuy)
        nStop += 1
    else
        nTaken += 1

// ───────────────────────── State ─────────────────────────
var float entryPx = na
var float slPx    = na
var float tp1Px   = na
var float tp2Px   = na
var float tp3Px   = na
var bool  tp1Done = false
var bool  tp2Done = false
var float posInit = na   // position size at the fill, for exact scale-outs

// Size so the distance to the stop costs riskPct of equity. With the stop tied
// to the signal candle, this is the only way two signals with different candle
// sizes risk the same money.
sizeFor(stopDist) =>
    q = 0.0
    if useRiskSizing
        risk = strategy.equity * riskPct / 100.0
        q := stopDist > 0 ? risk / stopDist : 0.0
    else
        q := strategy.equity * equityPct / 100.0 / close
    q

if sellSignal
    qty = sizeFor(stopSell)
    if qty > 0
        entryPx := close
        slPx    := high + buf
        r       = slPx - entryPx
        tp1Px   := entryPx - r * rr1
        tp2Px   := entryPx - r * rr2
        tp3Px   := entryPx - r * rr3
        tp1Done := false
        tp2Done := false
        posInit := na
        strategy.entry("Short", strategy.short, qty=qty)

if buySignal
    qty = sizeFor(stopBuy)
    if qty > 0
        entryPx := close
        slPx    := low - buf
        r       = entryPx - slPx
        tp1Px   := entryPx + r * rr1
        tp2Px   := entryPx + r * rr2
        tp3Px   := entryPx + r * rr3
        tp1Done := false
        tp2Done := false
        posInit := na
        strategy.entry("Long", strategy.long, qty=qty)

// Captured once, on the first bar the fill is visible. qty_percent in
// strategy.exit is a percent of the position AT THAT MOMENT, so chaining three
// of them made TP2 take 33% of the 66% left after TP1 - about 22% of the
// original, not 33%. Splitting off absolute quantities from the original size is
// what makes 34/33/33 actually mean 34/33/33.
if strategy.position_size != 0 and na(posInit)
    posInit := math.abs(strategy.position_size)
if strategy.position_size == 0
    posInit := na

// Which scale-outs have already been reached. These flags do double duty: they
// drive the break-even move, and they stop a filled exit from being re-issued.
//
// That second job is the important one. strategy.exit called again with an ID
// that has already FILLED places a NEW order - so re-issuing "TP1" every bar
// after TP1 filled puts another take-profit at a level price has already passed,
// and it fills immediately, closing a slice that was meant to run to TP2 or TP3.
// The scale-out quietly collapses into "exit everything at TP1".
if strategy.position_size != 0 and not na(tp1Px)
    isShort = strategy.position_size < 0
    if not tp1Done and (isShort ? low <= tp1Px : high >= tp1Px)
        tp1Done := true
        if beAfterTP1
            slPx := entryPx
    if not tp2Done and (isShort ? low <= tp2Px : high >= tp2Px)
        tp2Done := true

// Exits — three scale-outs sharing one stop.
if strategy.position_size != 0 and not na(slPx) and not na(posInit)
    q3pct = math.max(0, 100 - q1 - q2)
    qty1  = posInit * q1 / 100.0
    qty2  = posInit * q2 / 100.0

    if qty1 > 0 and not tp1Done
        strategy.exit("TP1", limit=tp1Px, stop=slPx, qty=qty1)
    if qty2 > 0 and not tp2Done
        strategy.exit("TP2", limit=tp2Px, stop=slPx, qty=qty2)

    // No qty, and always re-issued: TP3 covers whatever is left, so the stop
    // protects the whole remaining position even after TP1 and TP2 have gone
    // and their orders are no longer being placed.
    if q3pct > 0
        strategy.exit("TP3", limit=tp3Px, stop=slPx)
    else
        strategy.exit("TP3", stop=slPx)

if strategy.position_size == 0
    entryPx := na
    slPx    := na

// ───────────────────────── Plots ─────────────────────────
plot(emaF, "EMA fast", color.new(color.orange, 0), 2)
plot(emaS, "EMA slow", color.new(color.blue, 0), 2)

inTrade = strategy.position_size != 0
plot(inTrade ? slPx  : na, "SL",  color.red,   1, plot.style_linebr)
plot(inTrade ? tp1Px : na, "TP1", color.teal,  1, plot.style_linebr)
plot(inTrade ? tp2Px : na, "TP2", color.green, 1, plot.style_linebr)
plot(inTrade ? tp3Px : na, "TP3", color.lime,  1, plot.style_linebr)

plotshape(sellSignal, "Sell", shape.triangledown, location.abovebar, color.new(color.red,   0), size=size.small)
plotshape(buySignal,  "Buy",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)

// Faded arrows mark a raw signal a filter dropped, so the chart shows what was
// skipped rather than only what was taken.
dropped = (baseSell or baseBuy) and not (sellSignal or buySignal)
plotshape(dropped and baseSell, "Sell dropped", shape.triangledown, location.abovebar, color.new(color.red,   70), size=size.tiny)
plotshape(dropped and baseBuy,  "Buy dropped",  shape.triangleup,   location.belowbar, color.new(color.green, 70), size=size.tiny)

if showTable and barstate.islastconfirmedhistory
    t = table.new(position.top_right, 2, 6, border_width=1)
    table.cell(t, 0, 0, "raw signals",   text_color=color.gray,   text_size=size.small)
    table.cell(t, 1, 0, str.tostring(nRaw),   text_color=color.gray,   text_size=size.small)
    table.cell(t, 0, 1, "taken",         text_color=color.teal,   text_size=size.small)
    table.cell(t, 1, 1, str.tostring(nTaken), text_color=color.teal,   text_size=size.small)
    table.cell(t, 0, 2, "session/ATR",   text_color=color.red,    text_size=size.small)
    table.cell(t, 1, 2, str.tostring(nSess),  text_color=color.red,    text_size=size.small)
    table.cell(t, 0, 3, "trend quality", text_color=color.red,    text_size=size.small)
    table.cell(t, 1, 3, str.tostring(nTrend), text_color=color.red,    text_size=size.small)
    table.cell(t, 0, 4, "over-extended", text_color=color.red,    text_size=size.small)
    table.cell(t, 1, 4, str.tostring(nExt),   text_color=color.red,    text_size=size.small)
    table.cell(t, 0, 5, "stop distance", text_color=color.red,    text_size=size.small)
    table.cell(t, 1, 5, str.tostring(nStop),  text_color=color.red,    text_size=size.small)

alertcondition(sellSignal, "Sell signal", "EMA20 Close Fade: SELL {{ticker}} @ {{close}}")
alertcondition(buySignal,  "Buy signal",  "EMA20 Close Fade: BUY {{ticker}} @ {{close}}")

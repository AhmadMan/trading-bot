# Copy this file to .env and fill in real values, then run locally with:
#   python3 main.py
# .env is already in .gitignore — it will never get committed.

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TWELVEDATA_KEY=

# Powers all LLM text: macro synthesis, signal reasoning, and the Arabic
# executive summary. The macro step (step 2) skips itself cleanly if blank;
# the other steps fall back to plain-text output when it's blank.
GEMINI_API_KEY=
# Optional override — defaults to gemini-3.7-flash.
GEMINI_MODEL=
